# Database Connection (PostgreSQL / Neon)
# Replace with your own connection string (format: postgresql+asyncpg://user:password@host/dbname?sslmode=require)
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@your_host/your_dbname?sslmode=require

# Security & JWT Configuration
SECRET_KEY=generate_a_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1080 #18 HRS